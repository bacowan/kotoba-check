{
  "name": "Kotoba Check",
  "description": "Google Chrome Plugin to help with studying Japanese Vocabulary.",
  "version": "1.0.0",
  "key": "",
  "manifest_version": 3,
  "permissions": [
    "webNavigation",
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "images/icon-48.png"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/content.js"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ],
  "background": {
    "service_worker": "scripts/service-worker.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dict/*",
        "visualizer/visualizer.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}